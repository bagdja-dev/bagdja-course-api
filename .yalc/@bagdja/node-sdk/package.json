{
  "name": "@bagdja/node-sdk",
  "version": "0.1.7",
  "description": "Bagdja Platform Node.js SDK for Authentication Guard and Centralized Logging",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "push": "npm run build && npx yalc publish --push",
    "watch:push": "tsc -w & npx yalc publish --push --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "jose": "^5.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0"
  },
  "yalcSig": "0527fc1fabfb16014ea6370a588dd065"
}
